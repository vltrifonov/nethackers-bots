+    def _light_west_maze(self):
+        """Light a carried lamp before moving through the Castle's dark west maze."""
+        agent = self.agent
+        if self._pos()[0] >= 0 or agent.character.prop.blind:
+            return False
+        bl = agent.blstats
+        if any(max(abs(y - bl.y), abs(x - bl.x)) <= 1 for _, y, x, _, _ in agent.get_visible_monsters()):
+            return False
+        items = self._items()
+        if any('(lit)' in (item.text or '') for item in items):
+            return False
+        candidates = {'oil lamp', 'magic lamp', 'brass lantern'}
+        for item in items:
+            if item.category != nh.TOOL_CLASS or 'unpaid' in (item.text or ''):
+                continue
+            names = self._names(item)
+            if not names or not names <= candidates:
+                continue
+            letter = agent.inventory.items.get_letter(item)
+            attempt = ('west_lamp', letter)
+            if self._tries.get(attempt):
+                continue
+            self._tries[attempt] = 1
+
+            def gen():
+                if 'What do you want to use or apply?' in agent.single_message:
+                    yield letter
+
+            self._log(f'lighting {item.text!r} in the west maze')
+            with agent.atom_operation():
+                agent.step(A.Command.APPLY, gen())
+            return True
+        return False
+
     def plan_step(self):
         """Dive plan hook on the castle level while still on the west side: walk to the courtyard, then
         freeze the moat or try what might lift us over it. False: nothing (left) to try."""
