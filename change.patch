diff --git a/base/nhbot/dive_logic.py b/base/nhbot/dive_logic.py
index 19e4ceb..37e63a2 100644
--- a/base/nhbot/dive_logic.py
+++ b/base/nhbot/dive_logic.py
@@ -6414,9 +6414,31 @@ class DiveLogic:
         self.__dict__.setdefault('_engrave_turn', {})[spot] = bl.time
         agent.log(f'DIVE Elbereth before digging{" (blind)" if blind else ""}'
                   f'{" in the pit" if spot[3] else ""}: {[m[3].mname for m in near]}')
-        agent.engrave('Elbereth')
+        marker = self._blind_pit_ward_marker(spot) if blind and near else None
+        if marker is None:
+            agent.engrave('Elbereth')
+        else:
+            self._medusa_marker_attempt_level = spot[0]
+            agent.engrave('Elbereth', marker=marker)
         return True
 
+    def _blind_pit_ward_marker(self, spot):
+        agent = self.agent
+        char = agent.character
+        prop = char.prop
+        if char.role != Character.BARBARIAN or char.race != Character.ORC or not spot[3] or \
+                not self.on_medusa_level() or self.levitating() or prop.confusion or prop.stun or prop.hallu or \
+                getattr(self, '_medusa_marker_attempt_level', None) == spot[0]:
+            return None
+        for item in agent.inventory.items:
+            if item.category != nh.TOOL_CLASS or not item.is_unambiguous() or item.object.name != 'magic marker' or \
+                    item.status == Item.CURSED or item.shop_status != Item.NOT_SHOP:
+                continue
+            charges = (item.uses or '').rpartition(':')[2]
+            if not charges.lstrip('-').isdigit() or int(charges) >= 4:
+                return item
+        return None
+
     def _boulder_blocks_dig(self, key, spot):
         """DIG_BOULDER_FIX: 'There isn't enough room to dig in here' since our last apply on this square (it arrives a
         step after the apply): a boulder lies on it -- give the square up (see DIG_BOULDER_FIX)."""
