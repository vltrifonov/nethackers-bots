+    def _log_mines_return_map(self, level, dis):
+        """Public diagnostic for a remembered exit cut off in the observed map."""
+        agent = self.agent
+        exits = set(zip(*utils.isin(level.objects, G.STAIR_UP).nonzero()))
+        for position, destination in level.stair_destination.items():
+            if destination is None:
+                continue
+            dungeon, number = destination[0]
+            if (dungeon == level.dungeon_number and number == level.level_number - 1) or (
+                    dungeon == Level.DUNGEONS_OF_DOOM and level.level_number == 1):
+                exits.add(position)
+        if not exits or any(dis[position] >= 0 for position in exits):
+            return
+        tiles = np.full(dis.shape, '?', dtype='<U1')
+        tiles[level.seen] = '#'
+        tiles[level.walkable] = '.'
+        tiles[level.forbidden] = 'X'
+        tiles[level.intact_doors] = 'D'
+        tiles[level.shop | level.shop_interior] = '$'
+        tiles[utils.isin(level.objects, G.TRAPS)] = '^'
+        tiles[utils.isin(level.objects, FALL_TRAPS)] = 'v'
+        tiles[utils.isin(agent.glyphs, G.BOULDER)] = 'O'
+        tiles[agent.monster_tracker.monster_mask | utils.isin(agent.glyphs, G.PETS)] = 'm'
+        for position in exits:
+            tiles[position] = '<'
+        tiles[agent.blstats.y, agent.blstats.x] = '@'
+        terrain = '\n'.join(''.join(row) for row in tiles)
+        reachability = '\n'.join(''.join(row) for row in np.where(dis >= 0, '.', ' '))
+        agent.log('RETURN map ? unknown # known blocked . known walkable X forbidden D door $ shop '
+                  f'^ trap v fall O boulder m monster < exit @ hero\n{terrain}\nRETURN reachable\n{reachability}')
 
