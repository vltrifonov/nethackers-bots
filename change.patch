diff --git a/hed/nhbot/agent.py b/hed/nhbot/agent.py
index 26b285c..af16933 100644
--- a/hed/nhbot/agent.py
+++ b/hed/nhbot/agent.py
@@ -3071,8 +3071,33 @@ class Agent:
             mask = utils.isin(self.glyphs, G.SWALLOW)
             if not mask.any():
                 break
+            wand = self._engulfed_vortex_wand(mask)
+            if wand is not None:
+                self.log('ENGULFED: zapping a magic missile at the energy vortex')
+                self.zap(wand, 'n')
+                self.inventory.items.update(force=True)
+                continue
             assert self.melee_attack(*list(zip(*mask.nonzero()))[0])
 
+    def _engulfed_vortex_wand(self, mask):
+        bl = self.blstats
+        prop = self.character.prop
+        if (self.character.role != Character.MONK or bl.hitpoints <= max(18, bl.max_hitpoints // 3)
+                or prop.blind or prop.hallu or prop.polymorph or prop.confusion or prop.stun):
+            return None
+        species = (int(self.glyphs[mask][0]) - nh.GLYPH_SWALLOW_OFF) // 8
+        if nh.permonst(species).mname != 'energy vortex':
+            return None
+        # zap.c sends a ray to the engulfing monster before tracing the map.
+        # The wand avoids the vortex's passive electric shock from melee.
+        for item in self.inventory.items:
+            if (item.category == nh.WAND_CLASS and item.is_unambiguous() and item.object.name == 'magic missile'
+                    and item.status != Item.CURSED and item.shop_status == Item.NOT_SHOP
+                    and not self.inventory.is_known_empty(item)
+                    and not (item.uses or '').endswith(':0')):
+                return item
+        return None
+
     def _is_corpse_editable(self, monster_id, age_turn):
         permonst = MON.permonst(monster_id)
 
