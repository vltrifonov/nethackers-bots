+    def _prayer_escape_hostile(self):
+        """Identify a lone adjacent threat that ignores Elbereth and won't follow downstairs."""
+        dive = self.global_logic.dive
+        level = self.current_level()
+        bl = self.blstats
+        prop = self.character.prop
+        if not dive.diving or dive.climbing() or level.dungeon_number != Level.DUNGEONS_OF_DOOM or \
+                level.key() == dive.castle.castle_key or level.shop[bl.y, bl.x] or dive.levitating() or \
+                prop.blind or prop.confusion or prop.stun or prop.hallu or prop.polymorph or bl.carrying_capacity >= 4:
+            return None
+        threats = dive._near_hostiles(radius=2)
+        if len(threats) != 1:
+            return None
+        _, y, x, monster, glyph = threats[0]
+        if max(abs(y - bl.y), abs(x - bl.x)) != 1 or not nh.glyph_is_monster(glyph) or \
+                monster.mflags2 & M2_STALK or monster.mname in ('shopkeeper', 'Wizard of Yendor') or \
+                not dive._melee_ignores_elbereth(monster):
+            return None
+        return y, x, glyph
+
+    def _escape_after_prayer(self):
+        """Choose only a clear, legal step to a down stair, or descend if already on it."""
+        if self._prayer_escape is None:
+            return None
+        key, turn, origin, threat, stepped = self._prayer_escape
+        bl = self.blstats
+        level = self.current_level()
+        if (level.key(), bl.time, (bl.y, bl.x)) != (key, turn, origin) or \
+                bl.time - self._last_resort_stairs_turn <= 20 or self._prayer_escape_hostile() != threat:
+            return None
+        dive = self.global_logic.dive
+        distances = self.bfs()
+        stairs = [(distances[p], p) for p in level.get_stairs(down=True)
+                  if 0 <= distances[p] <= 1 and (not stepped or p == origin) and not level.shop[p] and
+                  (p == origin or (self.glyphs[p] in G.STAIR_DOWN and not self.monster_tracker.monster_mask[p])) and
+                  dive._stairs_ok(level, *p) and dive._avoid_stairs_until.get((key, p), -1) <= turn]
+        if stairs:
+            distance, target = min(stairs)
+            return target if distance else '>'
+        return None
