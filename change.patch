+    def _damaging_doorway_retreat(self):
+        """Step back into the room if a slower melee attacker punishes a doorway entry."""
+        if self._doorway_entry is None:
+            return None
+        key, origin, doorway, turn, hp = self._doorway_entry
+        bl = self.blstats
+        level = self.current_level()
+        prop = self.character.prop
+        if (level.key(), (bl.y, bl.x), bl.time) != (key, doorway, turn + 1) or \
+                (key, doorway) in self._doorway_retreats or hp - bl.hitpoints < max(8, bl.max_hitpoints / 5) or \
+                self.global_logic.dive.diving or bl.carrying_capacity >= 2 or \
+                prop.blind or prop.confusion or prop.stun or prop.hallu or prop.polymorph or \
+                level.shop[origin] or level.shop[doorway] or self.monster_tracker.monster_mask[origin] or \
+                self.glyphs[origin] != SS.S_room or self.bfs()[origin] != 1:
+            return None
+        threats = self.global_logic.dive._near_hostiles(radius=2)
+        if len(threats) != 1:
+            return None
+        _, y, x, monster, glyph = threats[0]
+        dy, dx = y - bl.y, x - bl.x
+        if max(abs(dy), abs(dx)) != 1 or not nh.glyph_is_monster(glyph) or monster.mmove >= 12 or \
+                dy * (bl.y - origin[0]) + dx * (bl.x - origin[1]) != 1 or \
+                not re.search(rf'\bThe {re.escape(monster.mname)} (hits|bites|claws|kicks|stings|butts)!',
+                              self.message, re.IGNORECASE):
+            return None
+        return origin
+
