+    def _post_prayer_retreat_step(self):
+        """Step out of at least one attacker's reach on the turn a prayer restores HP."""
+        bl = self.blstats
+        dive = self.global_logic.dive
+        prop = self.character.prop
+        if self.character.role != Character.ARCHEOLOGIST or self.character.race != Character.HUMAN or \
+                not dive.diving or self.prayer_failed or self.last_prayer_turn != bl.time or \
+                getattr(self, '_last_post_prayer_step', None) == bl.time or bl.hitpoints < bl.max_hitpoints or \
+                prop.blind or prop.hallu or prop.confusion or prop.stun or prop.polymorph or \
+                self.in_pit() or dive._in_own_pit():
+            return None
+        level = self.current_level()
+        if level.dungeon_number != Level.DUNGEONS_OF_DOOM or not any(
+                hp <= bl.max_hitpoints / 5 for turn, hp in dive._hp_history if bl.time - 4 <= turn < bl.time):
+            return None
+        hostiles = [(int(y), int(x)) for _, y, x, _, _ in self.get_visible_monsters()]
+
+        def adjacent_count(y, x):
+            return sum(max(abs(my - y), abs(mx - x)) <= 1 for my, mx in hostiles)
+
+        current = adjacent_count(bl.y, bl.x)
+        if current < 2:
+            return None
+        candidates = []
+        for y, x in zip(*(self.bfs() == 1).nonzero()):
+            pos = (int(y), int(x))
+            if level.objects[pos] not in (SS.S_room, SS.S_corr, SS.S_litcorr) or level.shop[pos] or \
+                    level.shop_interior[pos] or self.monster_tracker.monster_mask[pos] or self.glyphs[pos] in G.PETS:
+                continue
+            remaining = adjacent_count(*pos)
+            if remaining < current:
+                candidates.append((remaining, pos))
+        return min(candidates)[1] if candidates else None
+
