         if not jf_config.KNOWN_ITEMS or not self._in_scope():
             return None
         danger = self._danger()
+        pit_escape = danger is None
+        if pit_escape:
+            danger = self._pit_scroll_danger()
         if danger is None or self.mino._prayer_first():
             return None
+        if pit_escape:
+            if not self._teleport_ok() or self._unpaid():
+                return None
+            scroll = self._tele_scroll()
+            if scroll is None:
+                return None
+            candidates = [('read', scroll, 'known scroll of teleportation')]
+        else:
+            candidates = self._candidates(*danger)
         turn = self.agent.blstats.time
-        for plan in self._candidates(*danger):
+        for plan in candidates:
             if self._blocked.get(self._block_key(plan), -1) < turn:
                 return plan + (danger,)
