+        """Select ordinary food, reserving lycanthropy and stoning remedies for emergencies."""
+        wolfsbane = 'sprig of wolfsbane'
+        foods = [item for item in flatten_items(self.inventory.items)
+                 if item.category == nh.FOOD_CLASS and item.objs[0].name != wolfsbane and
+                 (not item.is_corpse() or
+                  item.monster_id in [MON.from_name(n) - nh.GLYPH_MON_OFF for n in ['lizard', 'lichen']]) and
+                 not (jf_config.LIZARD_KEEP and item.is_corpse() and item.monster_id == self.LIZARD_ID)]
+        bl = self.blstats
+        if foods or bl.hunger_state != Hunger.WEAK or bl.depth != 1 or \
+                self.character.role != Character.PRIEST or self.character.is_lycanthrope or \
+                self.current_level().dungeon_number != Level.DUNGEONS_OF_DOOM:
+            return foods
+
+        # When nothing else is available, a one-turn dose can buy time before the first faint.
+        nutrition = self.uhunger_weak_estimate()
+        if nutrition is None or nutrition > jf_config.THREAT_WEAK_MARGIN or \
+                self.is_safe_to_pray(self._hunger_prayer_gap()):
