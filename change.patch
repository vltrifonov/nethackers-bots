+    @Strategy.wrap
+    def escape_quest_portal(self):
+        """Take a visible, adjacent return portal before fighting on the Monk's Quest home."""
+        agent = self.agent
+        level = agent.current_level()
+        bl = agent.blstats
+        if (not self.diving or agent.character.role != Character.MONK
+                or level.dungeon_number != Level.QUEST or level.level_number != 1):
+            yield False
+        portal = self.quest_arrival
+        pos = (bl.y, bl.x)
+        prop = agent.character.prop
+        attempt = (level.key(), pos, bl.time)
+        if (portal is None or not utils.adjacent(pos, portal) or prop.blind or prop.confusion or prop.stun
+                or prop.hallu or prop.polymorph or agent.in_pit() or getattr(agent, '_beartrap_at', None) ==
+                (*level.key(), *pos) or getattr(self, '_quest_portal_attempt', None) == attempt):
+            yield False
+        if (agent.glyphs[portal] not in PORTAL or not level.walkable[portal] or level.forbidden[portal]
+                or (jf_config.TEMP_FORBID and level.forbidden_until[portal] > bl.time)
+                or agent.monster_tracker.monster_mask[portal] or not self._near_hostiles(radius=2)):
+            yield False
+        # The ordinary BFS excludes trap squares. Open just the visible, unoccupied portal.
+        portal_mask = np.zeros_like(level.walkable)
+        portal_mask[portal] = True
+        if agent.bfs(open_mask=portal_mask)[portal] != 1:
+            yield False
+        yield True
+        self._quest_portal_attempt = attempt
+        self.step_onto(*portal, 'magic portal')
+
     def leave_quest(self):
         """Home 1 is banked on arrival; walk back through the portal and keep diving."""
         agent = self.agent
