+    _DIG_ZAPPER = re.compile(r"\bThe ([^.!?]+?) zaps (?:a|an) [^.!?]+!")
+
+    def _step_from_dig_ray(self, level, monsters):
+        """Pick one adjacent dry dig square out of a confirmed shooter's line before making a pit."""
+        agent = self.agent
+        bl = agent.blstats
+        y, x = int(bl.y), int(bl.x)
+        key = level.key()
+        mark = getattr(self, '_dig_mark', None)
+        prop = agent.character.prop
+        if key in self._ray_dodged_levels or mark is None or mark[:2] != (key, (y, x)) or \
+                not self.shot_recently() or bl.time < self._dig_walk_blocked_until or \
+                prop.blind or prop.stun or prop.confusion or prop.polymorph or agent.in_pit() or self._in_own_pit():
+            return None
+        message = agent.message or ''
+        attack = self._DIG_ZAPPER.search(message)
+        if attack is None or 'You stop digging' not in message or not self._RANGED_HIT.search(message):
+            return None
+        shooters = [(int(my), int(mx)) for _, my, mx, mon, _ in monsters if mon.mname.casefold() == attack[1].casefold()]
+        if len(shooters) != 1:
+            return None
+        sy, sx = shooters[0]
+        candidates = []
+        for py, px in zip(*(agent.bfs() == 1).nonzero()):
+            pos = (int(py), int(px))
+            dy, dx = abs(sy - py), abs(sx - px)
+            if dy == 0 or dx == 0 or dy == dx or agent.monster_tracker.monster_mask[pos] or \
+                    level.objects[pos] in FALL_TRAPS or not self._diggable_spot(*pos):
+                continue
+            if any(utils.adjacent(pos, (my, mx)) and
+                   (mon.mmove >= 12 or self._melee_ignores_elbereth(mon)) for _, my, mx, mon, _ in monsters):
+                continue
+            candidates.append((max(dy, dx), pos))
+        return min(candidates, key=lambda candidate: (-candidate[0], candidate[1]))[1] if candidates else None
+
