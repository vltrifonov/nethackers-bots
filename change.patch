+    def _teleport_after_blocked_retreat(self, error):
+        """Use an identified scroll when hallucination leaves a fleeing Priest's stairs cut off."""
+        agent = self.agent
+        bl = agent.blstats
+        prop = agent.character.prop
+        if not str(error).startswith('Monster on a next tile when moving:') or not self.diving or \
+                agent.character.role != Character.PRIEST or not prop.hallu or prop.blind or \
+                prop.confusion or prop.stun or prop.polymorph or bl.hitpoints >= RETREAT_BELOW * bl.max_hitpoints or \
+                agent.current_level().dungeon_number != Level.DUNGEONS_OF_DOOM:
+            return False
+        known = agent.global_logic.known
+        if not known._teleport_ok() or known._unpaid():
+            return False
+        scroll = known._tele_scroll()
+        if scroll is None:
+            return False
+        known._act(('read', scroll, 'known teleport scroll after a blocked retreat',
+                    (self._near_hostiles(radius=1), 'blocked retreat', 0)))
+        return True
+
