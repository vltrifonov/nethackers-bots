+    def _note_couatl_wrap(self, key, pos, turn):
+        if self.agent.character.role != Character.MONK:
+            return
+        text = (self.agent.message or '').lower()
+        if 'you get released' in text or 'releases its grip' in text:
+            self._couatl_wrap = None
+        elif 'couatl swings itself around you' in text:
+            if self._couatl_wrap is None or self._couatl_wrap[:2] != (key, pos):
+                self._couatl_wrap = (key, pos, turn)
+        elif self._couatl_wrap is not None and self._couatl_wrap[:2] != (key, pos):
+            self._couatl_wrap = None
+
+    def _couatl_escape_marker(self):
+        agent = self.agent
+        wrap = self._couatl_wrap
+        if wrap is None or wrap == self._couatl_marker_attempt:
+            return None
+        bl = agent.blstats
+        level = agent.current_level()
+        prop = agent.character.prop
+        if wrap[:2] != (level.key(), (bl.y, bl.x)) or bl.time - wrap[2] > 3 or \
+                level.dungeon_number != Level.DUNGEONS_OF_DOOM or not self._in_own_pit() or self.levitating() or \
+                prop.hallu or prop.confusion or prop.stun or prop.polymorph or \
+                utils.any_in(agent.glyphs, G.SWALLOW) or not agent.can_engrave():
+            return None
+        for item in agent.inventory.items:
+            if item.category != nh.TOOL_CLASS or not item.is_unambiguous() or item.object.name != 'magic marker' or \
+                    item.status == Item.CURSED or item.shop_status != Item.NOT_SHOP:
+                continue
+            charges = (item.uses or '').rpartition(':')[2]
+            if charges.isdigit() and int(charges) >= 4:
+                return item
+        return None
+
