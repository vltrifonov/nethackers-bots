+            return False
+        main = self.inventory.items.main_hand
+        if main is None or not dive.is_digging_tool(main, False):
+            return False
+        # A pick can already hit the attacker. Swapping spends a turn exposed to its melee.
+        return any((y, x) == (target_y, target_x) and dive._melee_ignores_elbereth(mon)
