+    def _break_boxing_boulder(self):
+        agent = self.agent
+        level = agent.current_level()
+        bl = agent.blstats
+        char = agent.character
+        prop = char.prop
+        here = (int(bl.y), int(bl.x))
+        if not self.diving or char.role != Character.BARBARIAN or char.race != Character.HUMAN or \
+                level.dungeon_number != Level.DUNGEONS_OF_DOOM or bl.depth < jf_config.CASTLE_SCARE_DEPTH or \
+                prop.blind or prop.hallu or prop.confusion or prop.stun or prop.polymorph or \
+                level.objects[here] not in PITS or bl.time < self._dig_blocked_until or \
+                self.turns_on_level() < jf_config.STALL_MIN_TURNS:
+            return False
+        if (agent.bfs() >= 0).sum() != 1 or self._near_hostiles(radius=2):
+            return False
+        tool = self.digging_tool()
+        if tool is None or tool is not agent.inventory.items.main_hand:
+            return False
+        stairs = list(zip(*utils.isin(level.objects, G.STAIR_UP).nonzero()))
+        if not stairs:
+            return False
+
+        # Breaking one rock is useful only when its square alone reopens a known exit.
+        key = level.key()
+        for dest in agent.neighbors(*here, shuffle=False, diagonal=False):
+            attempt = (key, dest)
+            if agent.glyphs[dest] not in G.BOULDER or level.objects[dest] not in PLAIN_FLOOR or \
+                    agent.monster_tracker.monster_mask[dest] or \
+                    self._stall_tries.get(attempt, 0) >= jf_config.STALL_MAX_TRIES:
+                continue
+            opening = np.zeros(level.walkable.shape, dtype=bool)
+            opening[dest] = True
+            distance = agent.bfs(open_mask=opening)
+            if any(distance[stair] >= 0 for stair in stairs):
+                self._stall_tries[attempt] = self._stall_tries.get(attempt, 0) + 1
+                agent.log(f'STALL breaking adjacent boulder at {dest} to reconnect to the stairs')
+                self._dig_at_boulder(tool, dest)
+                return True
+        return False
+
