+    def _passive_fire_ward_step(self, near):
+        """Leave a pit edge whose bottom cannot be engraved after dangerous fire contact."""
+        agent = self.agent
+        bl = agent.blstats
+        level = agent.current_level()
+        prop = agent.character.prop
+        here = (bl.y, bl.x)
+        if not self.diving or level.key() in self._fire_ward_steps or bl.hitpoints * 3 >= bl.max_hitpoints or \
+                level.objects[here] not in PITS or agent.in_pit() or self._in_own_pit() or self.levitating() or \
+                prop.confusion or prop.stun or prop.hallu or len(near) != 1:
+            return None
+        distance, y, x, monster, glyph = near[0]
+        dy, dx = y - bl.y, x - bl.x
+        if distance != 1 or abs(dy) + abs(dx) != 1 or not nh.glyph_is_monster(glyph) or \
+                monster.mname != 'fire elemental' or 'You are suddenly very hot!' not in agent.message or \
+                'the fire elemental.' not in agent.message:
+            return None
+        target = (bl.y - dy, bl.x - dx)
+        if not (0 <= target[0] < agent.glyphs.shape[0] and 0 <= target[1] < agent.glyphs.shape[1]):
+            return None
+        target_glyph = agent.glyphs[target]
+        if not level.seen[target] or level.objects[target] not in G.VISIBLE_FLOOR or \
+                (target_glyph not in G.VISIBLE_FLOOR and not nh.glyph_is_object(target_glyph)) or \
+                agent.monster_tracker.monster_mask[target] or agent.bfs()[target] != 1:
+            return None
+        return target
+
