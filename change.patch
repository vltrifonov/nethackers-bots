+    def _prepare_fainting_descent(self):
+        """Prepare once for an exposed arrival when starvation can cause a faint on the next level."""
+        agent = self.agent
+        bl = agent.blstats
+        level = agent.current_level()
+        prop = agent.character.prop
+        if self._faint_descent_invis_tried or not self.diving or agent.character.role != Character.WIZARD or \
+                level.dungeon_number != Level.DUNGEONS_OF_DOOM or level.shop[bl.y, bl.x] or \
+                bl.hunger_state != Hunger.FAINTING or not self.starving() or getattr(agent, '_cfp_invis', False) or \
+                bl.carrying_capacity >= 4 or self.levitating() or prop.blind or prop.confusion or prop.stun or \
+                prop.hallu or prop.polymorph or self._near_hostiles(radius=4):
+            return False
+        items = agent.inventory.items
+        if any(item.category == nh.ARMOR_CLASS and item.equipped and 'mummy wrapping' in item.text for item in items):
+            return False
+        wand = next((item for item in items if self.castle._usable_wand(item, 'make invisible') and
+                     item.status != Item.CURSED and item.shop_status != Item.UNPAID and
+                     re.search(r'\(\d+:[1-9]\d*\)', item.text)), None)
+        if wand is None:
+            return False
+        self._faint_descent_invis_tried = True
+        agent.log('FAINTING DESCENT: using the known wand of make invisible before taking the stairs')
+        agent.zap(wand, '.')
+        return True
