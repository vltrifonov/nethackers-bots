+_COLD_HORN_SHOT = re.compile(
+    r"\bThe ([A-Za-z][A-Za-z '-]*?) plays an? (?:frost )?horn directed at you[!.]"
+    r".*?\bThe (?:bolt|ray) of cold hits you[!.]"
+)
+
+
+def cold_horn_escape(agent, dis):
+    """One clear step off the direct line of a freshly observed lethal horn burst."""
+    shot = _COLD_HORN_SHOT.search(agent.message)
+    if shot is None:
+        return None
+    bl = agent.blstats
+    dive = agent.global_logic.dive
+    previous_hp = max((hp for turn, hp in dive._hp_history if bl.time - 1 <= turn <= bl.time),
+                      default=bl.hitpoints)
+    if previous_hp - bl.hitpoints < bl.hitpoints:
+        return None
+    prop = agent.character.prop
+    level = agent.current_level()
+    here = (*level.key(), bl.y, bl.x)
+    if prop.blind or prop.confusion or prop.stun or prop.hallu or prop.polymorph or agent.in_pit() or \
+            getattr(agent, '_beartrap_at', None) == here or level.objects[bl.y, bl.x] in G.TRAPS:
+        return None
+    hostiles = agent.get_visible_monsters()
+    if len(hostiles) != 1 or hostiles[0][3].mname.casefold() != shot.group(1).casefold():
+        return None
+    _, sy, sx, _, _ = hostiles[0]
+    if max(abs(sy - bl.y), abs(sx - bl.x)) != 1:
+        return None
+    # A cardinal step avoids diagonal squeezes. The horn user needs an
+    # orthogonal or diagonal line, so a 2-by-1 offset breaks direct targeting.
+    for dy, dx in ((-1, 0), (0, 1), (1, 0), (0, -1)):
+        y, x = bl.y + dy, bl.x + dx
+        if not inside(agent, y, x) or dis[y, x] != 1 or agent.glyphs[y, x] not in G.VISIBLE_FLOOR or \
+                level.objects[y, x] in G.TRAPS or agent.monster_tracker.monster_mask[y, x]:
+            continue
+        ry, rx = abs(y - sy), abs(x - sx)
+        if ry and rx and ry != rx:
+            return dy, dx
+    return None
+
