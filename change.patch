+    def _deflect_blind_raven_with_mirror(self, y, x):
+        bl = self.blstats
+        char = self.character
+        prop = char.prop
+        dive = self.global_logic.dive
+        if char.role != Character.BARBARIAN or char.race != Character.HUMAN or not dive.diving or \
+                not prop.blind or prop.hallu or prop.confusion or prop.stun or prop.polymorph or \
+                bl.hitpoints * 3 > bl.max_hitpoints or bl.carrying_capacity >= 4 or not dive.on_medusa_level():
+            return False
+        level = self.current_level()
+        key = level.key()
+        target = (y, x)
+        here = (bl.y, bl.x)
+        previous = getattr(self, '_attack_ctx', None)
+        if getattr(self, '_blind_raven_mirror_level', None) == key or \
+                abs(y - bl.y) + abs(x - bl.x) != 1 or level.objects[target] in G.DOOR_CLOSED or \
+                previous is None or previous[1] != target or previous[3] != here or \
+                not 0 <= bl.time - previous[0] <= 1 or not self._hurt_recently(1):
+            return False
+        near = [m for m in self.get_visible_monsters() if max(abs(m[1] - bl.y), abs(m[2] - bl.x)) <= 2]
+        if len(near) != 1 or near[0][1:3] != target or near[0][3].mname != 'raven':
+            return False
+        mirror = next((it for it in self.inventory.items if it.category == nh.TOOL_CLASS and it.is_unambiguous() and
+                       it.object.name == 'mirror' and it.status != Item.CURSED and it.shop_status == Item.NOT_SHOP),
+                      None)
+        if mirror is None:
+            return False
+
+        # The mirror ray starts at the adjacent raven's tile, including over a pool.
+        # The monster sees its own reflection even while the hero is blind.
+        letter = self.inventory.items.get_letter(mirror)
+        self._blind_raven_mirror_level = key
+        with self.atom_operation():
+            self.step(A.Command.APPLY)
+            if 'What do you want to use or apply?' not in self.single_message:
+                return False
+            self.type_text(letter)
+            if 'In what direction?' not in self.single_message:
+                if 'What do you want to use or apply?' in self.single_message:
+                    self.step(A.Command.ESC)
+                return False
+            self.log(f'MEDUSA aiming a mirror at the adjacent raven at {target}')
+            self.direction(y, x)
+        return True
+
