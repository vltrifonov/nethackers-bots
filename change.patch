+    def _fresh_prayer_cover(self):
+        """Allow one cover action after recovering on a previously held square."""
+        agent = self.agent
+        bl = agent.blstats
+        prayer_turn = agent.last_prayer_turn
+        prop = agent.character.prop
+        if (self.diving or agent.character.role != Character.CAVEMAN or prayer_turn is None
+                or not getattr(agent, '_last_prayer_answered', False)
+                or not 0 <= bl.time - prayer_turn <= 2
+                or getattr(self, '_post_prayer_cover_turn', None) == prayer_turn
+                or bl.hitpoints < ELBERETH_REST_UNTIL * bl.max_hitpoints
+                or bl.hunger_state >= Hunger.WEAK or prop.hallu or prop.confusion or prop.stun):
+            return False
+        square = (agent.current_level().key(), bl.y, bl.x)
+        return square in self._hold_squares and any(
+            prayer_turn - 4 <= turn < prayer_turn and hp < RETREAT_BELOW * bl.max_hitpoints
+            for turn, hp in self._hp_history)
