+    def _retreat_after_crowded_landing(self):
+        """Leave a melee crowd when a new level still offers a clear step out of reach."""
+        bl = self.blstats
+        dive = self.global_logic.dive
+        prop = self.character.prop
+        if self.character.role != Character.BARBARIAN or self.character.race != Character.HUMAN or \
+                not dive.diving or not dive._fast_hp_loss() or self.in_pit() or dive._in_own_pit() or \
+                prop.blind or prop.hallu or prop.confusion or prop.stun or prop.polymorph:
+            return None
+        level = self.current_level()
+        visit = dive._visit_start
+        if level.dungeon_number != Level.DUNGEONS_OF_DOOM or visit[0] != level.key() or bl.time - visit[1] > 3 or \
+                getattr(self, '_crowd_retreat_visit', None) == visit:
+            return None
+        hostiles = [(int(y), int(x)) for _, y, x, _, _ in self.get_visible_monsters()]
+        if sum(max(abs(y - bl.y), abs(x - bl.x)) <= 1 for y, x in hostiles) < 2:
+            return None
+        safe = []
+        for y, x in zip(*(self.bfs() == 1).nonzero()):
+            pos = (int(y), int(x))
+            if level.objects[pos] not in (SS.S_room, SS.S_corr, SS.S_litcorr) or level.shop[pos] or \
+                    level.shop_interior[pos] or self.monster_tracker.monster_mask[pos] or self.glyphs[pos] in G.PETS:
+                continue
+            if all(max(abs(my - y), abs(mx - x)) > 1 for my, mx in hostiles):
+                safe.append((abs(y - bl.y) + abs(x - bl.x), pos))
+        return min(safe)[1] if safe else None
+
