+    def _eel_engraving_wand(self):
+        """Spend a known digging charge on a full ward after a newly observed wrap."""
+        agent = self.agent
+        prop = agent.character.prop
+        bl = agent.blstats
+        if (agent.character.role != Character.BARBARIAN or agent.character.race != Character.ORC
+                or prop.blind or prop.hallu or prop.confusion or prop.stun or prop.polymorph or self.levitating()
+                or agent.current_level().dungeon_number == GEHENNOM or not agent.can_engrave()
