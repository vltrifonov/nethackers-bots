+        stairs = [(int(d), int(y), int(x), bool(self.monster_tracker.monster_mask[y, x]),
+                   level.stair_destination.get((y, x))) for d, y, x, kind in dive.down_targets()
+                  if d <= 1 and kind == 'stairs']
+        self.log(f'PRAYER_STAIR_DIAG at={(int(bl.y), int(bl.x))} stairs={stairs} '
+                 f'hostiles={monsters[:12]} pit={self.in_pit()} levitating={dive.levitating()}')
