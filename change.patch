+        bl = self.blstats
+        dive = self.global_logic.dive
+        if self.character.role != Character.ARCHEOLOGIST or self.character.race != Character.HUMAN or \
+                not dive.diving or not dive._in_own_pit() or bl.hitpoints >= 0.4 * bl.max_hitpoints or \
