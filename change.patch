@@ -1809,6 +1809,35 @@ class DiveLogic:
             return above
         return None
 
+    def _teleport_before_retreat_step(self, y, x):
+        agent = self.agent
+        bl = agent.blstats
+        prop = agent.character.prop
+        if agent.current_level().dungeon_number != Level.GNOMISH_MINES or \
+                bl.hitpoints >= RETREAT_BELOW * bl.max_hitpoints or \
+                prop.blind or prop.confusion or prop.stun or prop.hallu:
+            return False
+        for _, my, mx, mon, _ in self._near_hostiles(radius=2):
+            if mon.mmove > 12 and not utils.adjacent((bl.y, bl.x), (my, mx)) and \
+                    utils.adjacent((y, x), (my, mx)):
+                break
+        else:
+            return False
+
+        # Only a scroll with a known effect and an inventory letter can replace this step.
+        items = agent.inventory.items
+        scroll = next((item for item in items if item.category == nh.SCROLL_CLASS and
+                       item.is_unambiguous() and item.object.name == 'teleportation' and
+                       item.status != Item.CURSED and item.shop_status != Item.UNPAID), None)
+        if scroll is None:
+            return False
+        letter = items.get_letter(scroll)
+        agent.log(f'RETREAT teleport: stairward step enters melee with {mon.mname}')
+        with agent.atom_operation():
+            agent.step(A.Command.READ)
+            agent.type_text(letter)
+        return True
+
