+                    or item.comment == 'EMPT' or agent.inventory.is_known_empty(item)):
+                continue
+            _, _, charges = (item.uses or '').partition(':')
+            if not charges.lstrip('-').isdigit() or int(charges) > 0:
+                return item
+        return None
