+    def _trace_post_prayer_stairs(self):
+        bl = self.blstats
+        dive = self.global_logic.dive
+        if self.character.role != Character.BARBARIAN or not dive.diving or \
+                self.prayer_failed or self.last_prayer_turn != bl.time or bl.hitpoints != bl.max_hitpoints:
+            return
+        level = self.current_level()
+        key = (level.key(), bl.time)
+        if getattr(self, '_prayer_stair_trace_key', None) == key:
+            return
+        self._prayer_stair_trace_key = key
+        monsters = [(m[3].mname, int(m[1]), int(m[2]), bool(getattr(m[3], 'mflags2', 0) & MON.M2_STALK))
