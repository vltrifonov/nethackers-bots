     @utils.debug_log('engulfed_fight')
     @Strategy.wrap
     def engulfed_fight(self):
-        if not utils.any_in(self.glyphs, G.SWALLOW):
+        swallowed = utils.isin(self.glyphs, G.SWALLOW)
+        if not swallowed.any():
             yield False
         yield True
+        main = self.inventory.items.main_hand
         if jf_config.ENGULF_WIELD:
             # a dig-diver is swallowed with the pick-axe in hand (base-jf25 s13: 'You begin bashing monsters
             # with your pick-axe' inside a fire vortex, dead 2 turns later): every blow from inside hits, so
             # one turn to take up the real weapon pays for itself
             best = self.inventory.get_best_melee_weapon()
-            main = self.inventory.items.main_hand
-            if best is not None and main is not best and (main is None or main.status != Item.CURSED):
-                self.log(f'ENGULFED: wielding {best.text!r} instead of {main.text if main else None!r}')
-                self.inventory.wield(best)
+        else:
+            best = self._air_elemental_weapon(main, swallowed)
+        if best is not None and main is not best and (main is None or main.status != Item.CURSED):
+            self.log(f'ENGULFED: wielding {best.text!r} instead of {main.text if main else None!r}')
+            self.inventory.wield(best)
         while True:
             mask = utils.isin(self.glyphs, G.SWALLOW)
             if not mask.any():
                 break
             assert self.melee_attack(*list(zip(*mask.nonzero()))[0])
 
+    def _air_elemental_weapon(self, main, swallowed):
+        prop = self.character.prop
+        if self.current_level().dungeon_number != Level.DUNGEONS_OF_DOOM or \
+                prop.blind or prop.hallu or prop.polymorph or main is None or main.status == Item.CURSED or \
+                not main.is_unambiguous() or main.object.name not in ('pick-axe', 'dwarvish mattock'):
+            return None
+        # An ordinary air elemental gets three 1d10 engulf attacks per turn.
+        if self.blstats.hitpoints <= 30:
+            return None
+        # Swallow glyphs contain eight consecutive tiles per species.
+        mnum = (int(self.glyphs[swallowed][0]) - nh.GLYPH_SWALLOW_OFF) // 8
+        if nh.permonst(mnum).mname != 'air elemental':
+            return None
+        return next((item for item in self.inventory.items
+                     if item.is_unambiguous() and item.object.name == 'long sword' and item.dmg_bonus and
+                     'Excalibur' in (item.text or '') and item.status in (Item.UNCURSED, Item.BLESSED) and
+                     item.shop_status == Item.NOT_SHOP), None)
+
     def _is_corpse_editable(self, monster_id, age_turn):
         permonst = MON.permonst(monster_id)
 
