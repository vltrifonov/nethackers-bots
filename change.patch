+    def _pit_scroll_danger(self):
+        # An interrupted dig can leave two state updates many turns apart. At the first update back,
+        # the usual two-turn burst history contains only the damage already taken in the pit.
+        agent = self.agent
+        bl = agent.blstats
+        hp = int(bl.hitpoints)
+        if hp * 3 > bl.max_hitpoints or agent.character.prop.confusion or \
+                not self.dive._in_own_pit() or not self.dive.shot_recently() or \
+                self.dive._hurt_on_elbereth != bl.time:
+            return None
+        history = self.dive._hp_history
+        if len(history) < 2 or history[-1][0] != bl.time:
+            return None
+        previous_turn, previous_hp = history[-2]
+        loss = int(previous_hp) - hp
+        if bl.time - previous_turn <= jf_config.KNOWN_ITEMS_BURST_TURNS or loss < hp:
+            return None
+        pos = (int(bl.y), int(bl.x))
+        adjacent = [m for m in agent.get_visible_monsters() if m[3].mname not in WEAK_MONSTERS and
+                    _cheb((m[1], m[2]), pos) == 1]
+        if adjacent:
+            return adjacent, 'pit under fire', loss
+        return None
+
     def _on_elbereth(self):
         """An Elbereth under us that we can read back (not while blind: dust can't be felt)."""
         agent = self.agent
