+    def _stall_probe_boulder(self, stairs):
+        """Try a corridor boulder whose far side is unseen when a shallow rescue cannot reach known stairs."""
+        agent = self.agent
+        level = agent.current_level()
+        prop = agent.character.prop
+        if not self.rescue or level.dungeon_number != Level.DUNGEONS_OF_DOOM or \
+                agent.blstats.depth > jf_config.STALL_DOWNSEARCH_MAX_DEPTH or \
+                self.turns_on_level() < jf_config.STALL_MIN_TURNS or prop.blind or prop.hallu or \
+                prop.confusion or prop.stun or prop.polymorph or self.levitating() or self._near_hostiles(radius=1):
+            return False
+
+        dis = agent.bfs()
+        if any(dis[stairs_pos] >= 0 for stairs_pos in stairs):
+            return False
+
+        key = level.key()
+        pushes = []
+        for y, x in zip(*utils.isin(agent.glyphs, G.BOULDER).nonzero()):
+            boulder = (int(y), int(x))
+            if level.objects[boulder] not in G.CORRIDOR or level.shop[boulder]:
+                continue
+            for py, px in agent.neighbors(*boulder, shuffle=False, diagonal=False):
+                before = (int(py), int(px))
+                if dis[before] < 0 or level.objects[before] not in G.CORRIDOR or \
+                        (key, boulder, before) in self._boulder_push_failed:
+                    continue
+                ty, tx = 2 * y - py, 2 * x - px
+                if 0 <= ty < C.SIZE_Y and 0 <= tx < C.SIZE_X and level.objects[ty, tx] == -1 and \
+                        int(agent.glyphs[ty, tx]) in G.STONE and not agent.monster_tracker.monster_mask[ty, tx]:
+                    pushes.append((int(dis[before]), boulder, before))
+
+        if not pushes:
+            return False
+        distance, boulder, before = min(pushes)
+        attempt = (key, boulder, before)
+        if distance > 0:
+            try:
+                agent.go_to(*before, max_steps=1)
+            except AgentPanic:
+                self._boulder_push_failed.add(attempt)
+            return True
+        self._boulder_push_failed.add(attempt)
+        return self._stall_clear(boulder, 'unseen corridor beyond boulder', probe_unknown=True)
+
